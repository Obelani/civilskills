# CivilSkills — variáveis de configuração
#
# Este projeto é um site estático (HTML puro, sem build/bundler), então
# estas variáveis NÃO são lidas automaticamente pelo navegador. Este
# arquivo documenta os valores necessários; a configuração que a página
# realmente usa fica em config.js (na raiz do projeto) — copie os valores
# reais para lá antes de publicar em produção.

# ID do Meta Pixel usado no <head> do index.html.
META_PIXEL_ID=

# URL de checkout do Pacote Simples (R$10).
CHECKOUT_URL_SIMPLES=

# URL de checkout do Pacote Completo (R$27).
CHECKOUT_URL_COMPLETO=
